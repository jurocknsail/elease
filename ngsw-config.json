{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/icons/android-chrome-192x192.png",
          "/icons/apple-touch-icon.png",
          "/media/inter-latin-wght-normal-*.woff2",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "pdf-worker",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/pdfjs/pdf.worker.min.mjs"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
